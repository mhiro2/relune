<svg xmlns="http://www.w3.org/2000/svg" width="1637" height="1141" viewBox="0 0 1637 1141" fill="none"><defs>
<style>
.edge-particles { opacity: 0; pointer-events: none; transition: opacity 0.18s ease; }
