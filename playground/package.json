{
  "name": "@relune/playground",
  "private": true,
  "description": "Public WASM playground for relune",
  "scripts": {
    "build": "node esbuild.config.mjs",
    "fmt": "oxfmt -c ../.oxfmtrc.json",
    "fmt:check": "oxfmt -c ../.oxfmtrc.json --check",
    "lint": "oxlint -c ../.oxlintrc.json src esbuild.config.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check": "pnpm fmt:check && pnpm lint && pnpm typecheck"
  },
  "dependencies": {
    "@codemirror/commands": "6.10.4",
    "@codemirror/lang-sql": "6.10.0",
    "@codemirror/language": "6.12.4",
    "@codemirror/search": "6.7.1",
    "@codemirror/state": "6.7.1",
    "@codemirror/view": "6.43.7",
    "@lezer/highlight": "1.2.3",
    "codemirror": "6.0.2"
  },
  "devDependencies": {
    "esbuild": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript": "catalog:"
  }
}
